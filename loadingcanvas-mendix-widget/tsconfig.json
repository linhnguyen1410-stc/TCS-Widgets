{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    /* Linting */
    // Unused-local checks stay off: hidden debug controls are kept as commented JSX
    // (see LoadingCanvas.tsx) and @rollup/plugin-typescript fails the build on TS6133.
    // Dead code is still reported as warnings by @typescript-eslint/no-unused-vars.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
